      "parameters": {
        "language": "javaScript",
        "jsCode": "// v2: Match Shopify line items against Amount Reference SKU masters,\n// emit one row per line ITEM (not per unit). Row format matches the Mar 2026 sheet:\n// 12 columns. Prices come from Amount Reference. -COLOUR in master = wildcard.\n//\n// PAGINATION TBD: still single page. Add Link-header cursor before going to prod for >250 orders.\n\n// --- 1. Build SKU master list from Amount Reference ---\nconst refRows = $input.all().map(it => it.json);\n\nfunction parsePrice(s) {\n  if (s === undefined || s === null || s === '') return 0;\n  const m = String(s).replace(/[$,\\s]/g, '').match(/-?\\d+(?:\\.\\d+)?/);\n  return m ? parseFloat(m[0]) : 0;\n}\n\nfunction escRegex(s) {\n  return s.replace(/[.+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nconst masters = [];\nfor (const r of refRows) {\n  // Trim whitespace incl. trailing \\r seen in source data\n  const sku = String(r['SKU'] || '').trim();\n  if (!sku) continue;\n  const listing  = parsePrice(r['Listing Price']);\n  const fee      = parsePrice(r['3DPS + Stripe Fee (3.4%)']);\n  const takehome = parsePrice(r['Gavin Amount (Takehome)']);\n  // Build a regex per master. -COLOUR (case-insensitive) matches any color suffix.\n  const pat = sku.includes('COLOUR')\n    ? '^' + escRegex(sku).replace(/COLOUR/g, '.+') + '$'\n    : '^' + escRegex(sku) + '$';\n  masters.push({\n    sku, listing, fee, takehome,\n    re: new RegExp(pat, 'i'),\n  });\n}\n\nfunction findMaster(actualSku) {\n  if (!actualSku) return null;\n  for (const m of masters) if (m.re.test(actualSku)) return m;\n  return null;\n}\n\n// --- 2. Date formatting helpers ---\nconst MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nfunction fmtDate(iso) {\n  if (!iso) return '';\n  const d = new Date(iso);\n  if (isNaN(d.getTime())) return iso.split('T')[0];\n  return d.getDate() + ' ' + MON[d.getMonth()] + ' ' + d.getFullYear();\n}\nfunction fmtSGD(n) { return '$' + Number(n).toFixed(2); }\n\n// --- 3. Iterate orders -> matched line items -> rows ---\nconst orders = $('Fetch Orders (page 1, max 250)').first().json.orders || [];\nconst rows = [];\n\nfor (const o of orders) {\n  for (const li of (o.line_items || [])) {\n    const m = findMaster(li.sku);\n    if (!m) continue;\n\n    const firstName = (o.customer && o.customer.first_name) || '';\n    const lastName  = (o.customer && o.customer.last_name)  || '';\n    const name = (firstName + ' ' + lastName).trim() || 'Guest';\n    // Order No. = order_number (stripped of '#'), e.g. 4201\n    const orderNo = o.order_number != null\n      ? String(o.order_number)\n      : String(o.name || '').replace('#','');\n\n    rows.push({\n      json: {\n        'Order No.':                orderNo,\n        'Date':                     fmtDate(o.created_at),\n        'Name':                     name,\n        'Email':                    o.email || '',\n        'Gdrive access':            '',\n        'SKU':                      li.sku || '',\n        'Listing Price':            fmtSGD(m.listing),\n        '3DPS+Stripe Fee':          fmtSGD(m.fee),\n        'Gavin Amount (Takehome)':  fmtSGD(m.takehome),\n        'Payment Complete':         '',\n        'Date of Payment':          '',\n        'Remarks':                  '',\n      }\n    });\n  }\n}\n\nreturn rows;\n"
      },
