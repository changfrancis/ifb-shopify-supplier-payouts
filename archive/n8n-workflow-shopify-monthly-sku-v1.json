      "id": "9b3a2d10-0004-4000-9000-000000000004",
      "name": "Fetch Orders (page 1, max 250)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Filter line items to those matching any pattern in TARGET_SKU_PATTERNS.\n// Patterns are comma-separated and case-insensitive.\n// Use '*' as a wildcard, e.g. 'gfz-smiley-bolt-*' matches red/blue/green variants.\n// Emits one row per matching line item (so a single order with 3 different matching SKUs = 3 rows).\n//\n// PAGINATION TBD: currently reads only the first page (max 250 orders/month).\n// For 250-2000 orders/month, add Link-header cursor follow before going to prod.\n\nconst rawPatterns = $('Set Parameters').first().json.TARGET_SKU_PATTERNS || '';\nconst patterns = rawPatterns\n  .split(',')\n  .map(s => s.trim())\n  .filter(Boolean);\n\nfunction globToRegex(pattern) {\n  // Escape regex specials, then turn '*' into '.*'\n  const escaped = pattern.replace(/[.+?^${}()|[\\]\\\\]/g, '\\\\$&').replace(/\\*/g, '.*');\n  return new RegExp('^' + escaped + '$', 'i');\n}\nconst regexes = patterns.map(globToRegex);\n\nfunction matchesAny(sku) {\n  if (!sku) return null;\n  for (let i = 0; i < regexes.length; i++) {\n    if (regexes[i].test(sku)) return patterns[i];\n  }\n  return null;\n}\n\nconst orders = $input.first().json.orders || [];\nconst rows = [];\n\nfor (const o of orders) {\n  for (const li of (o.line_items || [])) {\n    const matchedPattern = matchesAny(li.sku);\n    if (!matchedPattern) continue;\n\n    const firstName = (o.customer && o.customer.first_name) || '';\n    const lastName  = (o.customer && o.customer.last_name)  || '';\n    const customer  = (firstName + ' ' + lastName).trim() || 'Guest';\n    const unitPrice = parseFloat(li.price || 0);\n    const qty       = li.quantity || 0;\n\n    rows.push({\n      json: {\n        order_id:           String(o.id),\n        order_name:         o.name,\n        date:               (o.created_at || '').split('T')[0],\n        customer,\n        email:              o.email || '',\n        financial_status:   o.financial_status || '',\n        fulfillment_status: o.fulfillment_status || 'unfulfilled',\n        sku:                li.sku,\n        matched_pattern:    matchedPattern,\n        product_title:      li.title || '',\n        variant_title:      li.variant_title || '',\n        quantity:           qty,\n        unit_price:         unitPrice,\n        line_total:         Number((unitPrice * qty).toFixed(2)),\n        currency:           o.currency\n      }\n    });\n  }\n}\n\nreturn rows;\n"
      },
