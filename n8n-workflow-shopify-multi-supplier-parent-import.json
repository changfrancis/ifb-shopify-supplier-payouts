    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Compute per-supplier walkin_tab_name + dest_tab_name from template + MONTH_NAME.\n// Bundle (supplier, orders, params) for the child sub-workflow.\n\nconst { DateTime } = require('luxon');\nconst params = $('Set Parameters').first().json;\nconst orders = $('Fetch All Orders (paginated)').all().flatMap(p => p.json.orders || []);\n\nfunction renderTemplate(tpl, monthName) {\n  // Renders Luxon-style format from MONTH_START_ISO. Common templates:\n  //   'LLL yyyy' -> 'Mar 2026'   (Gavin/Stan/Piggy/Bluebird/Ryan/Dylan)\n  //   'LLL yy'   -> 'Mar 26'     (Bryan, Vitae)\n  if (!tpl) return monthName;\n  const dt = DateTime.fromISO(params.MONTH_START_ISO, { zone: 'Asia/Singapore' });\n  return dt.toFormat(tpl);\n}\n\nconst suppliers = $input.all().map(it => it.json);\nconst out = [];\nfor (const s of suppliers) {\n  const monthName = params.MONTH_NAME;\n  const walkinTpl = String(s.walkin_tab_template || 'LLL yyyy');\n  const walkinTab = renderTemplate(walkinTpl, monthName);\n  const destTpl   = String(s.dest_tab_template || \"LLL yyyy '\" + (s.supplier_name || 'Supplier') + \" n8n'\");\n  // Render dest_tab_template; format string syntax — we accept a literal-friendly form: 'Mar 2026 <Supplier> n8n'\n  // Simplest: ignore the template and just compose: '<MonthName> <Supplier> n8n'\n  const destTab = monthName + ' ' + (s.supplier_name || 'Supplier') + ' n8n';\n  out.push({\n    json: {\n      supplier: {\n        ...s,\n        walkin_tab_name: walkinTab,\n        dest_tab_name:   destTab,\n      },\n      orders,\n      params,\n    },\n  });\n}\nreturn out;\n"
      },
      "id": "v5p-compute-tabs",
